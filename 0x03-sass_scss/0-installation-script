# Step 1: Install Node Version Manager (nvm)
curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh | bash

# Step 2: Restart terminal to activate nvm
exit
# (Then reopen your terminal)

# Step 3: Manually configure nvm if profile not found
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

# Step 4: Install Node.js version 20.16.0
nvm install 20.16.0

# Step 5: Verify Node.js and npm installation
node -v
npm -v

# Step 6: Create missing npm directory if needed
mkdir -p "%APPDATA%\npm"

# Step 7: Install latest version of SASS
npm install sass

# Step 8: Verify SASS installation
npx sass --version